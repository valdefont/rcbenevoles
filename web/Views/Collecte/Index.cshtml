@model CollecteFilterModel

@{
    Layout = "~/Views/Shared/_CollecteLayout.cshtml";
    ViewData["Title"] = "Index";
}

<h2>Bienvenue dans l'application Collecte</h2>
<p>Utilisez le formulaire ci-dessous pour rechercher des enregistrements de collecte.</p>

<!-- Search Form -->
<div class="panel panel-default">
    <div class="panel-heading">
        <h3 class="panel-title">Rechercher un enregistrement</h3>
    </div>
    <div class="panel-body">
        <form id="searchForm" method="get">
            <div class="form-group row">
                <label class="col-sm-2 control-label">Centre :</label>
                <div class="col-sm-4">
                    <select id="CentreID" class="form-control">
                        <option value="0">- Tous les centres -</option>
                        @foreach (var centre in Model.Centres)
                        {
                            <option value="@centre.ID">@centre.Nom</option>
                        }
                    </select>
                </div>

                <label class="col-sm-2 control-label">Enseigne :</label>
                <div class="col-sm-4">
                    <select id="EnseignDetailID" class="form-control">
                        <option value="0">- Toutes les enseignes -</option>
                        @foreach (var ens in Model.EnseigneDetails)
                        {
                            <option value="@ens.ID">@ens.Enseigne.Name - @ens.CodeCommune.NomCommune</option>
                        }
                    </select>
                </div>
            </div>

            <div class="form-group row" style="margin-top:10px;">
                <label class="col-sm-2 control-label">Date début :</label>
                <div class="col-sm-4">
                    <input type="date" id="DateDebut" class="form-control" />
                </div>

                <label class="col-sm-2 control-label">Date fin :</label>
                <div class="col-sm-4">
                    <input type="date" id="DateFin" class="form-control" />
                </div>
            </div>

            <div class="form-group row" style="margin-top:10px;">
                <div class="col-sm-12 text-right">
                    <button class="btn btn-primary" onclick="filter(); return false;">Filtrer</button>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="row" style="margin-top:20px;">
    <div class="col-md-6">
        <a asp-action="Create" class="btn btn-success">Créer un nouvel enregistrement</a>
    </div>
    <div class="col-md-6 text-right">
        <form asp-action="ExportExcel" method="get" id="exportForm">
            <input type="hidden" name="CentreID" id="ExportCentreID" />
            <input type="hidden" name="EnseigneDetailID" id="ExportEnseigneDetailID" />
            <input type="hidden" name="DateDebut" id="ExportDateDebut" />
            <input type="hidden" name="DateFin" id="ExportDateFin" />
            <button type="submit" class="btn btn-info">Export Excel</button>
        </form>
    </div>
</div>


<!-- Results Table -->
<div style="margin-top:20px;">
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>ID</th>
                <th>Enseigne</th>
                <th>Centre</th>                
                <th>Poids</th>
                <th>Crée le</th>
                <th>Crée Par</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody id="updateBody">
            <tr>
                <td colspan="5"><em>Veuillez lancer une recherche...</em></td>
            </tr>
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            //filter();
        });

        function filter() {
            $.ajax({
                url: '@Url.Action("Filter")',
                data: {
                    CentreID: $("#CentreID").val(),
                    NumBulletin: $("#EnseigneDetailID").val(),
                    DateDebut: $("#DateDebut").val(),
                    DateFin: $("#DateFin").val()
                },
                type: 'GET',
                success: function (data) {
                    $('#updateBody').replaceWith(data);
                },
                error: function () {
                    alert("Erreur lors du chargement des enregistrements.");
                }
            });
        }

        function syncExportFilters() {
            $("#ExportCentreID").val($("#CentreID").val());
            $("#ExportNumBulletin").val($("#EnseigneDetailID").val());
            $("#ExportDateDebut").val($("#DateDebut").val());
            $("#ExportDateFin").val($("#DateFin").val());
        }

        $("#exportForm").on("submit", function () {
            syncExportFilters();
        });

    </script>
}
