@model web.Models.CollecteFormViewModel
@{
    ViewData["Title"] = "Créer une nouvelle collecte";
    Layout = "~/Views/Shared/_CollecteLayout.cshtml";
}

<h2>Créer une nouvelle collecte</h2>

<form asp-action="Create" method="post">
    <div class="panel panel-default">
        <div class="panel-body">

            @if (!ViewData.ModelState.IsValid)
            {
                <div asp-validation-summary="All" class="alert alert-warning"></div>
            }

            <!-- CENTRE -->
            <div class="form-group">
                <label class="control-label">Centre</label>
                <select asp-for="CentreID" id="CentreID" class="form-control" asp-items="Model.Centres">
                    <option value="">-- Sélectionner un centre --</option>
                </select>
                <span asp-validation-for="CentreID" class="text-danger"></span>
            </div>

            <!-- ENSEIGNE DETAIL -->
            <div class="form-group">
                <label class="control-label">Enseigne</label>
                <select asp-for="EnseigneDetailID"
                        id="EnseigneDetailID"
                        class="form-control"
                        asp-items="Model.EnseignesDetail">
                    <option value="">-- Sélectionner une enseigne --</option>
                </select>
                <span asp-validation-for="EnseigneDetailID" class="text-danger"></span>
            </div>

            <!-- POIDS -->
            <div class="form-group">
                <label asp-for="Poids" class="control-label"></label>
                <input asp-for="Poids" class="form-control"  />
                <span asp-validation-for="Poids" class="text-danger"></span>
            </div>

            <!-- BUTTONS -->
            <div class="form-group text-right" style="margin-top:10px;">
                <a asp-action="Index" class="btn btn-default">Retour</a>
                <button type="submit" class="btn btn-success">Enregistrer</button>
            </div>
        </div>
    </div>
</form>

@section Scripts {

    @await Html.PartialAsync("_ValidationScriptsPartial")


    <script>
        $("#CentreID").change(function () {

            var centreId = $(this).val();
            var ddl = $("#EnseigneDetailID");

            ddl.empty();
            ddl.append($("<option>").val("").text("-- Chargement... --"));

            if (centreId !== "") {

                $.ajax({
                    url: '@Url.Action("GetEnseignesByCentre", "Collecte")',
                    data: { centreId: centreId },
                    success: function (data) {

                        ddl.empty();
                        ddl.append($("<option>").val("").text("-- Sélectionner une enseigne --"));

                        $.each(data, function (i, item) {
                            ddl.append($("<option>").val(item.id).text(item.nom));
                        });
                    }
                });

            } else {
                ddl.empty().append($("<option>").val("").text("-- Sélectionner une enseigne --"));
            }
        });
    </script>
}