@model IEnumerable<dal.models.Collecte>

<tbody id="updateBody">
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.ID</td>
            <td>@item.EnseigneDetail.Enseigne.Name - @item.EnseigneDetail.CodeCommune.NomCommune</td>
            <td>@item.EnseigneDetail.Centre?.Nom</td>           
            <td>@item.Poids</td>
            <td>@item.DateCreation</td>
            <td>@item.Utilisateur?.Login</td>
            <td>
                <a asp-controller="Collecte" asp-action="Edit" asp-route-id="@item.ID">Modifier</a>
                @if (User.IsInRole("SuperAdmin"))
                {
                    <span> &#124;</span> <a asp-action="Delete" asp-route-id="@item.ID">Supprimer</a>
                    
                }
                
            </td>
        </tr>
    }
    @if (!Model.Any())
    {
        <tr>
            <td colspan="5"><em>Aucun résultat trouvé.</em></td>
        </tr>
    }
</tbody>
