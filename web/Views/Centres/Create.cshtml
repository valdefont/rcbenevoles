@model dal.models.Centre

@{
    ViewData["Title"] = "Créer";
}

<h2>Gestion des centres</h2>

<h3>Créer un centre</h3>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
			<input asp-for="SiegeID" type="hidden" class="form-control" value="1" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Nom" class="control-label required"></label>
                <input asp-for="Nom" class="form-control" />
                <span asp-validation-for="Nom" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Rue" class="control-label required"></label>
                <input asp-for="Rue" class="form-control" />
                <span asp-validation-for="Rue" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="CodePostal" class="control-label required"></label>
                <input asp-for="CodePostal" class="form-control" id="CodePostal" />
                <span asp-validation-for="CodePostal" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Commune" class="control-label required"></label>
                <input asp-for="Commune" class="form-control" id="CommuneInput" />
                <span asp-validation-for="Commune" class="text-danger"></span>
            </div>

            <!-- Modal -->
            <div id="communePopup" class="popup-overlay" style="display:none;">
                <div class="popup-content">
                    <h4>Sélectionner une commune</h4>
                    <div id="communeList"></div>
                    <button onclick="closePopup()">Fermer</button>
                </div>
            </div>


            <div class="form-group">
                <label asp-for="Telephone" class="control-label required"></label>
                <input asp-for="Telephone" class="form-control" />
                <span asp-validation-for="Telephone" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="EMail" class="control-label required"></label>
                <input asp-for="EMail" class="form-control" />
                <span asp-validation-for="EMail" class="text-danger"></span>
            </div>
            <div class="form-group">
                <a asp-action="Index" class="btn btn-link">Retourner à la liste</a>
                <input type="submit" value="Créer" class="btn btn-success" />
                
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        var getCommunesUrl = '@Url.Action("GetCommunesByCodePostal", "Centres")';
    </script>
    <script src="~/js/centre-edit.min.js"></script>
}

