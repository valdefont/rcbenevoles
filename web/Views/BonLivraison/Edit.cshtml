@model dal.models.BonLivraison

@{
    ViewData["Title"] = "Modifier un Bon de Livraison";
}

<h2>Modifier un Bon de Livraison</h2>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit">
            <input type="hidden" asp-for="ID" />

            <div class="form-group">
                <label asp-for="CentreID" class="control-label required"></label>
                <select asp-for="CentreID" asp-items="@(new SelectList(ViewBag.Centres, "ID", "Nom"))" class="form-control">
                    <option value="">- Veuillez sélectionner un centre -</option>
                </select>
                <span asp-validation-for="CentreID" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="DateLivraison" class="control-label required"></label>
                <input asp-for="DateLivraison" class="form-control" type="date" />
                <span asp-validation-for="DateLivraison" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Poids" class="control-label required"></label>
                <input asp-for="Poids" class="form-control" />
                <span asp-validation-for="Poids" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="NumBulletin" class="control-label"></label>
                <input asp-for="NumBulletin" class="form-control" readonly />
            </div>

            <div class="form-group">
                <a asp-action="Index" class="btn btn-link">Retourner à la liste</a>
                <input type="submit" value="Enregistrer" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
