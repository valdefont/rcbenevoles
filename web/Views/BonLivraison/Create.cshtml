@model dal.models.BonLivraison

@{
    ViewData["Title"] = "Créer";
}

<h2>Gestion des Bons de Livraison</h2>

<h3>Créer un Bon de Livraison</h3>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <!-- Centre Dropdown -->
            <div class="form-group">
                <label asp-for="CentreID" class="control-label required"></label>
                <select asp-for="CentreID" asp-items="@(new SelectList(ViewBag.Centres, "ID", "Nom"))" class="form-control">
                    <option value="">- Veuillez sélectionner un centre -</option>
                </select>
                <span asp-validation-for="CentreID" class="text-danger"></span>
            </div>

            <!-- Date Livraison (default to today) -->
            <div class="form-group">
                <label asp-for="DateLivraison" class="control-label required"></label>
                <input asp-for="DateLivraison" class="form-control" type="date" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                <span asp-validation-for="DateLivraison" class="text-danger"></span>
            </div>

            <!-- Poids -->
            <div class="form-group">
                <label asp-for="Poids" class="control-label required"></label>
                <input asp-for="Poids" class="form-control" />
                @if (ViewData.ModelState["Poids"]?.Errors.Count > 0)
                {
                    <span class="text-danger">Le poids est requis et doit être un nombre valide.</span>
                }
            </div>

            <!-- Submit -->
            <div class="form-group">
                <a asp-action="Index" class="btn btn-link">Retourner à la liste</a>
                <input type="submit" value="Créer" class="btn btn-success" />
            </div>
        </form>
    </div>
</div>



@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
