@model dal.models.BonLivraison

@{
    ViewData["Title"] = "Supprimer";
}

<h2>Gestion des bénévoles</h2>

<h3>Confirmez-vous la suppression du bon de livraison suivant ?</h3>

<div>
    <hr />
    <dl class="dl-horizontal">
        <dt>
            @Html.DisplayNameFor(model => model.NumBulletin)
        </dt>
        <dd>
            @Html.DisplayFor(model => model.NumBulletin)
        </dd>
        <dt>
            @Html.DisplayNameFor(model => model.Centre.Nom)
        </dt>
        <dd>
            @Html.DisplayFor(model => model.Centre.Nom)
        </dd>
        <dt>
            @Html.DisplayNameFor(model => model.DateLivraison)
        </dt>
        <dd>
            @Html.DisplayFor(model => model.DateLivraison)
        </dd>
        <dt>
            @Html.DisplayNameFor(model => model.Poids)
        </dt>
        <dd>
            @Html.DisplayFor(model => model.Poids)
        </dd>
       
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="ID" />
        <button type="submit" class="btn btn-danger">Supprimer</button>
        <a asp-action="Index" class="btn btn-secondary">Annuler</a>
