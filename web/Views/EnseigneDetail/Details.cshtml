@model dal.models.EnseigneDetail

@{
    ViewData["Title"] = "Details";
}

<h2>Gestion des enseignes</h2>

<h3>Détail de l'enseigne</h3>

<div>
    <hr />
    <dl class="dl-horizontal">

        <dt>Enseigne</dt>
        <dd>@Html.DisplayFor(model => model.Enseigne.Name)</dd>

        <dt>Commune</dt>
        <dd>@Html.DisplayFor(model => model.CodeCommune.NomCommune)</dd>

        <dt>Centre</dt>
        <dd>@Html.DisplayFor(model => model.Centre.Nom)</dd>

        <dt>@Html.DisplayNameFor(model => model.Adresse)</dt>
        <dd>@Html.DisplayFor(model => model.Adresse)</dd>

        <dt>@Html.DisplayNameFor(model => model.EstActif)</dt>
        <dd>@Html.DisplayFor(model => model.EstActif)</dd>

        <!-- ✅ UTILISATEURS -->
        <dt>Utilisateurs associés</dt>
        <dd>
            @if (Model.EnseigneDetailUtilisateurs != null &&
            Model.EnseigneDetailUtilisateurs.Any())
            {
                <ul class="mb-0">
                    @foreach (var link in Model.EnseigneDetailUtilisateurs
                   .OrderBy(x => x.Utilisateur.Login))
                    {
                        <li>@link.Utilisateur?.Login</li>
                    }
                </ul>
            }
            else
            {
                <span class="text-muted">Aucun utilisateur associé</span>
            }
        </dd>

    </dl>
</div>

<div>
