@model dal.models.EnseigneDetailFormVm

@{
    ViewData["Title"] = "Modifier";
}

@using Microsoft.AspNetCore.Mvc.Rendering
@using System.Linq

@{
    var enseignes = ViewData["EnseigneID"] as IEnumerable<SelectListItem>
                    ?? Enumerable.Empty<SelectListItem>();

    var centres = ViewData["CentreID"] as IEnumerable<SelectListItem>
                  ?? Enumerable.Empty<SelectListItem>();

    var utilisateurs = ViewData["Utilisateurs"] as IEnumerable<SelectListItem>
                       ?? Enumerable.Empty<SelectListItem>();
}

<h2>Gestion des enseignes</h2>

<h3>Modifier le détail d’enseigne</h3>
<hr />

<div class="row">
    <div class="col-md-4">

        <form asp-action="Edit" asp-route-id="@Model.Detail.ID" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <!-- Hidden ID (important for binding) -->
            <input type="hidden" asp-for="Detail.ID" />

            <!-- ENSEIGNE -->
            <div class="form-group">
                <label asp-for="Detail.EnseigneID" class="control-label required"></label>
                <select asp-for="Detail.EnseigneID"
                        asp-items="enseignes"
                        class="form-control">
                </select>
                <span asp-validation-for="Detail.EnseigneID" class="text-danger"></span>
            </div>

            <!-- CODE COMMUNE -->
            <div class="form-group">
                <label asp-for="Detail.CodeCommuneID" class="control-label required"></label>

                <!-- Visible autocomplete text box -->
                <input type="text"
                       id="CommuneSearch"
                       class="form-control"
                       value="@Model.Detail.CodeCommune?.NomCommune"
                       placeholder="Commencez à taper..." />

                <!-- Hidden field storing selected ID -->
                <input type="hidden" asp-for="Detail.CodeCommuneID" id="CodeCommuneID" />

                <span asp-validation-for="Detail.CodeCommuneID" class="text-danger"></span>
            </div>

            <!-- ADRESSE -->
            <div class="form-group">
                <label asp-for="Detail.Adresse" class="control-label"></label>
                <input asp-for="Detail.Adresse" class="form-control" />
                <span asp-validation-for="Detail.Adresse" class="text-danger"></span>
            </div>

            <!-- CENTRE -->
            <div class="form-group">
                <label asp-for="Detail.CentreID" class="control-label required"></label>
                <select asp-for="Detail.CentreID"
                        asp-items="centres"
                        class="form-control">
                </select>
                <span asp-validation-for="Detail.CentreID" class="text-danger"></span>
            </div>

            <!-- UTILISATEURS -->
            <div class="form-group">
                <label asp-for="UtilisateurIds" class="control-label"></label>
                <select asp-for="UtilisateurIds"
                        asp-items="utilisateurs"
                        class="form-control"
                        multiple="multiple"
                        size="8">
                </select>
                <span asp-validation-for="UtilisateurIds" class="text-danger"></span>
                <small class="form-text text-muted">
                    Maintenez Ctrl (Windows) / Cmd (Mac) pour sélectionner plusieurs utilisateurs.
                </small>
            </div>

            <!-- ACTIF -->
            <div class="form-group">
                <label asp-for="Detail.EstActif" class="control-label"></label><br />
                <input asp-for="Detail.EstActif" />
                <span asp-validation-for="Detail.EstActif" class="text-danger"></span>
            </div>

            <div class="form-group">
                <a asp-action="Index" class="btn btn-link">Retourner à la liste</a>
                <input type="submit" value="Modifier" class="btn btn-success" />
            </div>

        </form>

    </div>
</div>

@section Scripts {

    @await Html.PartialAsync("_ValidationScriptsPartial")

    <script>
        $(function () {

            $("#CommuneSearch").autocomplete({
                source: function (request, response) {
                    $.ajax({
                        url: "/EnseigneDetail/SearchCommune",
                        data: { term: request.term },
                        success: function (data) {
                            response(data);
                        }
                    });
                },
                minLength: 3,
                select: function (event, ui) {
                    $("#CommuneSearch").val(ui.item.label);
                    $("#CodeCommuneID").val(ui.item.id).trigger("change");
                    return false;
                }
            });

            // If user edits manually → reset ID
            $("#CommuneSearch").on("input", function () {
                $("#CodeCommuneID").val("").trigger("change");
            });

        });
    </script>
}
