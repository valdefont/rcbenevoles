@model dal.models.Utilisateur

@using Microsoft.AspNetCore.Http
@{

    if (Context.Session.GetString("AppActive") == "Livraison")
    {
        Layout = "~/Views/Shared/_BonLivraisonLayout.cshtml";
    }
    else if (Context.Session.GetString("AppActive") == "Collecte")
    {
        Layout = "~/Views/Shared/_CollecteLayout.cshtml";
    }
    else if (Context.Session.GetString("AppActive") == "Pointage")
    {
        Layout = "~/Views/Shared/_Layout.cshtml";
    }

    ViewData["Title"] = "Mon Compte";
}

<h2>Mon compte</h2>
<p>
    <a asp-action="ChangePassword">Changer mon mot de passe</a>
</p>
<p>
    Vous êtes connectés sous <strong>@Model.Login</strong>.
    <br/>
@if(Model.Centre == null)
{ 
    <text>
    Vous pouvez gérer les bénévoles de <strong>tous les centres</strong>, leurs pointages, ainsi que les fonctions d'administration avancées.
    </text>
}
else
{
    <text>
    Vous êtes rattachés au centre de <strong>@Model.Centre.Nom</strong>.
    </text>
}
</p>
